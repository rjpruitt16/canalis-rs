# Aquifer's soak driver, plus the Valkey the Canalis nodes share (so a
# scenario can take it down). Build from this directory:
#   fly deploy -c fly.driver.toml --dockerfile Dockerfile.driver --build-arg AQUIFER_REF=<commit> .
FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git
ARG AQUIFER_REF=main
WORKDIR /src
RUN git clone https://github.com/rjpruitt16/aquifer.git . && git checkout "$AQUIFER_REF" && \
    go build -o /driver ./benchmark/soak/driver

FROM alpine:3.22
RUN apk add --no-cache ca-certificates valkey
COPY --from=builder /driver /driver
# Every open request and every webhook coming back is an open file. A
# backlog clearing at once needs more than Fly's default of 10,240; past
# it the driver can't connect, which it counts as client errors.
ENTRYPOINT ["sh", "-c", "ulimit -n 1048576 2>/dev/null || ulimit -n 65536 2>/dev/null; exec /driver \"$@\"", "driver"]
