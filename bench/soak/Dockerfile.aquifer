# An Aquifer instance behind Canalis, under the soak supervisor. Everything
# comes from Aquifer's repository at AQUIFER_REF: Aquifer, the supervisor,
# the soak config and start script. Build from this directory:
#   fly deploy -c fly.aquifer-1.toml --dockerfile Dockerfile.aquifer --build-arg AQUIFER_REF=<commit> .
FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git
ARG AQUIFER_REF=main
WORKDIR /src
RUN git clone https://github.com/rjpruitt16/aquifer.git . && git checkout "$AQUIFER_REF" && \
    go build -o /out/aquifer ./cmd/aquifer && go build -o /out/supervisor ./benchmark/soak/supervisor && \
    cp benchmark/soak/aquifer-soak.yml benchmark/soak/target-start.sh /out/

FROM alpine:3.22
RUN apk add --no-cache ca-certificates valkey
WORKDIR /app
COPY --from=builder /out/ ./
ENV AQUIFER_ADAPTER=http \
    PORT=8080 \
    DB_PATH=/data/aquifer.db \
    L8_KEY_PATH=/data/l8-key \
    CONFIG_PATH=/app/aquifer-soak.yml \
    AQUIFER_DEBUG_ADDR=127.0.0.1:6060
CMD ["/app/target-start.sh"]
