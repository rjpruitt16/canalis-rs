# The Spillway instance behind Canalis, under the soak supervisor. Spillway
# is cloned at SPILLWAY_REF, the supervisor and start script at AQUIFER_REF.
# Build from this directory:
#   fly deploy -c fly.spillway.toml --dockerfile Dockerfile.spillway \
#     --build-arg AQUIFER_REF=<commit> --build-arg SPILLWAY_REF=<commit> .
FROM golang:1.25-alpine AS supervisor
RUN apk add --no-cache git
ARG AQUIFER_REF=main
WORKDIR /src
RUN git clone https://github.com/rjpruitt16/aquifer.git . && git checkout "$AQUIFER_REF" && \
    go build -o /out/supervisor ./benchmark/soak/supervisor && cp benchmark/soak/target-start.sh /out/

FROM elixir:1.17-alpine AS build
ARG SPILLWAY_REF=main
# cmake, bash and linux-headers build RocksDB for SPILLWAY_STORAGE=rocksdb.
RUN apk add --no-cache build-base git cmake bash linux-headers snappy-dev
# RocksDB and its bundled Snappy use uint64_t without including <cstdint>,
# which GCC 15 (Alpine's) no longer pulls in on its own. Include it in every
# C++ file, and link Alpine's Snappy rather than building the bundled copy.
ENV ERLANG_ROCKSDB_OPTS="-DWITH_SNAPPY=ON -DWITH_BUNDLE_LZ4=ON" \
    CXXFLAGS="-include cstdint"
WORKDIR /src
RUN git clone https://github.com/rjpruitt16/spillway.git . && git checkout "$SPILLWAY_REF"
# Spillway's prod config binds IPv4 only, but the driver reaches it over
# Fly's private network, which is IPv6. Bind dual-stack for the soak.
RUN sed -i 's/ip: {0, 0, 0, 0},/ip: {0, 0, 0, 0, 0, 0, 0, 0},/' config/runtime.exs && \
    grep -q 'ip: {0, 0, 0, 0, 0, 0, 0, 0}' config/runtime.exs
ENV MIX_ENV=prod
RUN mix local.hex --force && mix local.rebar --force && \
    mix deps.get --only prod && mix deps.compile && mix compile && mix release

FROM alpine:3.22
RUN apk add --no-cache libstdc++ openssl ncurses-libs ca-certificates snappy valkey
WORKDIR /app
COPY --from=build /src/_build/prod/rel/spillway ./
COPY --from=supervisor /out/ ./
# The supervisor runs one command with no arguments; the release script
# execs down to the BEAM, so its kill -9 reaches the VM itself.
RUN printf '#!/bin/sh\nexec /app/bin/spillway start\n' > /app/run-spillway.sh && chmod +x /app/run-spillway.sh
ENV PORT=4000 \
    PHX_SERVER=true \
    PHX_HOST=canalis-soak-spillway \
    SOAK_CMD=/app/run-spillway.sh \
    SOAK_STORE=store
CMD ["/app/target-start.sh"]
